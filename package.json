{
	"name": "gaslight-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx src/development/index.ts",
		"start": "node dist/index.js",
		"build": "tsc",
		"lint": "npx eslint \"**/*.ts\"",
		"lint:fix": "npx eslint \"**/*.ts\" --fix",
		"spellcheck": "npx cspell .",
		"test": "node --env-file-if-exists=.env --env-file=.env.test --import tsx --test \"src/**/*.test.ts\"",
		"test:unit": "node --env-file-if-exists=.env --env-file=.env.test --import tsx --test \"src/**/*.unit.test.ts\"",
		"test:integration": "node --env-file-if-exists=.env --env-file=.env.test --import tsx --test \"src/**/*.integration.test.ts\"",
		"test:development": "node --env-file-if-exists=.env --env-file=.env.test --import tsx --test \"src/**/*.development.test.ts\""
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"overrides": {
		"mongodb": "~6.20.0"
	},
	"dependencies": {
		"@logtail/node": "^0.5.8",
		"@sentry/cli": "^3.5.1",
		"@sentry/node": "^10.59.0",
		"@sentry/profiling-node": "^10.59.0",
		"@socket.io/redis-adapter": "^8.3.0",
		"axios": "^1.18.0",
		"bcrypt": "^6.0.0",
		"config": "^4.4.1",
		"connect-mongo": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"esprima": "^4.0.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"express-session": "^1.19.0",
		"helmet": "^8.2.0",
		"mongoose": "^9.7.1",
		"nanoid": "^5.1.14",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"redis": "^6.0.0",
		"socket.io": "^4.8.3",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bcrypt": "^6.0.0",
		"@types/config": "^4.4.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/eslint": "^9.6.1",
		"@types/esprima": "^4.0.6",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^26.0.0",
		"@types/passport": "^1.0.17",
		"@types/passport-local": "^1.0.38",
		"cspell": "^10.0.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.1.0",
		"eslint-plugin-promise": "^7.3.0",
		"mongodb-memory-server": "^11.2.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	}
}
